<UserControl
    x:Class="LightBulb.Views.Components.Settings.UsbSensorSettingsTabView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LightBulb.Converters"
    xmlns:settings="clr-namespace:LightBulb.ViewModels.Components.Settings"
    x:DataType="settings:UsbSensorSettingsTabViewModel">
    <StackPanel Margin="16" Orientation="Vertical">

        <!--  Enable toggle  -->
        <DockPanel LastChildFill="False" ToolTip.Tip="Enable adaptive screen adjustment via USB RGB sensor">
            <TextBlock DockPanel.Dock="Left" Text="Enable USB Sensor" />
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" />
        </DockPanel>

        <!--  Port selection  -->
        <DockPanel Margin="0,16,0,0" LastChildFill="False" ToolTip.Tip="Serial port the sensor is connected to (e.g. COM3)">
            <TextBlock DockPanel.Dock="Left" Text="Serial Port" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <ComboBox
                    IsEnabled="{Binding !IsEnabled}"
                    ItemsSource="{Binding AvailablePortNames}"
                    SelectedItem="{Binding PortName}" />
                <Button
                    Command="{Binding AutoDetectPortCommand}"
                    Content="Otomatik Bul"
                    IsEnabled="{Binding !IsTestingConnection}"
                    Theme="{DynamicResource MaterialOutlinedButton}"
                    ToolTip.Tip="Tüm portları tarar ve sensörün bağlı olduğu portu otomatik seçer" />
            </StackPanel>
        </DockPanel>

        <!--  Baud rate  -->
        <DockPanel Margin="0,8,0,0" LastChildFill="False" ToolTip.Tip="Sensörün baud rate hızı (Arduino firmware ile aynı olmalı)">
            <TextBlock DockPanel.Dock="Left" Text="Baud Rate" />
            <ComboBox
                DockPanel.Dock="Right"
                IsEnabled="{Binding !IsEnabled}"
                ItemsSource="{Binding AvailableBaudRates}"
                SelectedItem="{Binding BaudRate}" />
        </DockPanel>

        <!--  Connection test  -->
        <DockPanel Margin="0,8,0,0" LastChildFill="False" ToolTip.Tip="Sensöre test komutu gönderir ve geçerli bir RGB yanıtı alınırsa bağlantı kurulmuş sayılır">
            <TextBlock
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                Text="{Binding ConnectionStatusText}" />
            <Button
                DockPanel.Dock="Right"
                Command="{Binding TestConnectionCommand}"
                Content="Bağlantıyı Test Et"
                IsEnabled="{Binding !IsTestingConnection}"
                Theme="{DynamicResource MaterialOutlinedButton}" />
        </DockPanel>

        <!--  Read interval  -->
        <!--  Slider pozisyonu: 1-59 = saniye modu, 60-179 = dakika modu (1-120 dk)  -->
        <DockPanel Margin="0,24,0,0" ToolTip.Tip="Sensörün ne sıklıkta okunacağı. 1-59: saniye aralığı (OKU_Sxx), 60+: dakika aralığı (OKU_xx)">
            <TextBlock DockPanel.Dock="Left" Text="Okuma Aralığı" />
            <TextBlock
                DockPanel.Dock="Right"
                FontWeight="SemiBold"
                Text="{Binding IntervalLabel}" />
        </DockPanel>
        <Slider
            Margin="0,4,0,0"
            IsSnapToTickEnabled="True"
            LargeChange="15"
            Maximum="179"
            Minimum="1"
            SmallChange="1"
            TickFrequency="1"
            Value="{Binding SliderPosition}" />

        <!--  Read command  -->
        <DockPanel Margin="0,16,0,0" LastChildFill="False" ToolTip.Tip="Sensöre gönderilecek komut ön eki (örn: OKU). Dakika değeriyle birleşerek final emri oluşturur.">
            <TextBlock DockPanel.Dock="Left" Text="Okuma Komutu" />
            <TextBox
                MinWidth="80"
                DockPanel.Dock="Right"
                Text="{Binding ReadCommand, UpdateSourceTrigger=LostFocus}"
                Theme="{DynamicResource CompactTextBox}" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0" LastChildFill="False" ToolTip.Tip="Sensöre gönderilecek final emir">
            <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Gönderilecek Emir" />
            <TextBlock
                DockPanel.Dock="Right"
                FontFamily="Monospace"
                FontWeight="SemiBold"
                Text="{Binding FinalCommand}" />
        </DockPanel>

        <!--  RGBL Profil Editörü — bağımsız profil oluşturma aracı, sensör testi ile karıştırılmamalı  -->
        <Button
            Margin="0,24,0,0"
            HorizontalAlignment="Stretch"
            Command="{Binding OpenCalibrationWindowCommand}"
            Content="🎛️  RGBL Profil Editörü"
            Theme="{DynamicResource MaterialOutlinedButton}"
            ToolTip.Tip="Ortam ışığı seviyelerine karşı üretilecek gerçek RGBL çıktı değerlerini tanımlayan profil eğrilerini düzenler. Sensör simülasyonundan bağımsız bir işlemdir." />

        <!--  RGBL Profil Çıktısı — JSON dosyasından hesaplanan anlık çıkış değerleri  -->
        <Border
            Margin="0,8,0,0"
            Padding="8"
            Background="{DynamicResource MaterialCardBackgroundBrush}"
            CornerRadius="4">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="RGBL Profil Çıktısı" />
                <DockPanel LastChildFill="False" ToolTip.Tip="RGBL kalibrasyon JSON'unun yüklenme durumu">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Durum" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RgblLoadStatus}" />
                </DockPanel>
                <DockPanel LastChildFill="False" ToolTip.Tip="L = pre-computed LT brightness multiplier; ambient seviyesindeki parlaklık çarpanı (0-100 %)">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="L çıkış" />
                    <TextBlock DockPanel.Dock="Right" FontFamily="Monospace" Text="{Binding LatestRgblLText}" />
                </DockPanel>
                <DockPanel LastChildFill="False" ToolTip.Tip="RGBL eğrisinin mevcut ambient seviyesinde hesapladığı kırmızı çıkış (0-100 %)">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="R çıkış" />
                    <TextBlock DockPanel.Dock="Right" FontFamily="Monospace" Text="{Binding LatestRgblRText}" />
                </DockPanel>
                <DockPanel LastChildFill="False" ToolTip.Tip="Yeşil kanal çıkışı (0-100 %)">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="G çıkış" />
                    <TextBlock DockPanel.Dock="Right" FontFamily="Monospace" Text="{Binding LatestRgblGText}" />
                </DockPanel>
                <DockPanel LastChildFill="False" ToolTip.Tip="Mavi kanal çıkışı (0-100 %)">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="B çıkış" />
                    <TextBlock DockPanel.Dock="Right" FontFamily="Monospace" Text="{Binding LatestRgblBText}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!--  Son Okuma (gerçek sensör verisi)  -->
        <Border
            Margin="0,16,0,0"
            Padding="8"
            Background="{DynamicResource MaterialCardBackgroundBrush}"
            CornerRadius="4">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Son Okuma" />

                <!--  Parsed values (shown after a successful read)  -->
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Raw" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastRawReading}" />
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="CCT" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestCctText}" />
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Luminance" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestLuminance, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}}" />
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Komut" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        FontFamily="Monospace"
                        Text="{Binding LastReadCommand}" />
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Zaman" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastReadTime}" />
                </DockPanel>

                <!--  Diagnostic rows — always visible; show "—" until first read attempt  -->
                <Separator Margin="0,4,0,4" Opacity="0.3" />
                <DockPanel
                    LastChildFill="False"
                    ToolTip.Tip="Sensörden gelen ham seri yanıt (ayrıştırılmadan önce). Parse başarısızsa burada nedenini görebilirsiniz.">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Seri Yanıt" />
                    <SelectableTextBlock
                        DockPanel.Dock="Right"
                        FontFamily="Monospace"
                        FontSize="10"
                        MaxWidth="260"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Text="{Binding LastRawResponse}" />
                </DockPanel>
                <DockPanel
                    LastChildFill="False"
                    ToolTip.Tip="Son okuma denemesinde oluşan hata (başarılıysa boş)">
                    <TextBlock DockPanel.Dock="Left" Opacity="0.6" Text="Hata" />
                    <SelectableTextBlock
                        DockPanel.Dock="Right"
                        FontSize="11"
                        Foreground="#EF5350"
                        MaxWidth="260"
                        TextWrapping="Wrap"
                        Text="{Binding LastReadError}" />
                </DockPanel>

                <!--  Giren/Çıkan Debug Tablosu — modülden ne geldi, sisteme ne gitti  -->
                <Separator Margin="0,4,0,4" Opacity="0.3" />
                <TextBlock FontWeight="SemiBold" Text="Giren / Çıkan" />
                <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <!--  Başlık satırı  -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.5" FontSize="10" Text="Kanal" Margin="0,0,12,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Opacity="0.5" FontSize="10" Text="Giren (Modül)" Margin="0,0,8,2" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Opacity="0.5" FontSize="10" Text="Çıkan (Sistem)" Margin="0,0,0,2" />
                    <!--  R  -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.6" Text="R" Margin="0,0,12,1" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Monospace" Text="{Binding LatestProcRText}" Margin="0,0,8,1" />
                    <TextBlock Grid.Row="1" Grid.Column="2" FontFamily="Monospace" Text="{Binding LatestRgblRText}" />
                    <!--  G  -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.6" Text="G" Margin="0,0,12,1" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Monospace" Text="{Binding LatestProcGText}" Margin="0,0,8,1" />
                    <TextBlock Grid.Row="2" Grid.Column="2" FontFamily="Monospace" Text="{Binding LatestRgblGText}" />
                    <!--  B  -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Opacity="0.6" Text="B" Margin="0,0,12,1" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Monospace" Text="{Binding LatestProcBText}" Margin="0,0,8,1" />
                    <TextBlock Grid.Row="3" Grid.Column="2" FontFamily="Monospace" Text="{Binding LatestRgblBText}" />
                    <!--  L — Giren: ambient % (X girdi), Çıkan: L eğrisi çıktısı  -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Opacity="0.6" Text="L" Margin="0,0,12,1"
                               ToolTip.Tip="Giren: RGBL eğrisine X girdi olarak beslenen ambient %. Çıkan: L eğrisinin bu noktadaki değeri." />
                    <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Monospace" Text="{Binding LatestAmbientPctText}" Margin="0,0,8,1" />
                    <TextBlock Grid.Row="4" Grid.Column="2" FontFamily="Monospace" Text="{Binding LatestRgblLText}" />
                    <!--  max  -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Opacity="0.6" Text="max" Margin="0,0,12,1"
                               ToolTip.Tip="Giren: modülün üretebileceği maksimum değer (100%). Çıkan: L eğrisinin X=100'deki değeri." />
                    <TextBlock Grid.Row="5" Grid.Column="1" FontFamily="Monospace" Opacity="0.5" Text="100.0 %" Margin="0,0,8,1" />
                    <TextBlock Grid.Row="5" Grid.Column="2" FontFamily="Monospace" Text="{Binding RgblBoundaryMaxLText}" />
                    <!--  min  -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Opacity="0.6" Text="min" Margin="0,0,12,1"
                               ToolTip.Tip="Giren: modülün üretebileceği minimum değer (0%). Çıkan: L eğrisinin X=0'daki değeri." />
                    <TextBlock Grid.Row="6" Grid.Column="1" FontFamily="Monospace" Opacity="0.5" Text="0.0 %" Margin="0,0,8,1" />
                    <TextBlock Grid.Row="6" Grid.Column="2" FontFamily="Monospace" Text="{Binding RgblBoundaryMinLText}" />
                </Grid>

                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding ReadNowCommand}"
                    Content="Şimdi Oku"
                    Theme="{DynamicResource MaterialOutlinedButton}"
                    ToolTip.Tip="Zamanlayıcıyı beklemeden sensörden hemen veri çeker. Toggle kapalı olsa bile çalışır; port geçici açılıp kapatılır." />
            </StackPanel>
        </Border>

        <!--  Sensör Simülasyonu — sahte değer enjekte ederek RGBL profilini test eder  -->
        <Border
            Margin="0,16,0,0"
            Padding="8"
            Background="{DynamicResource MaterialCardBackgroundBrush}"
            CornerRadius="4">
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Sensör Simülasyonu" />
                <TextBlock
                    Opacity="0.6"
                    TextWrapping="Wrap"
                    FontSize="11"
                    Text="Gerçek sensör yokken sahte R/G/B değerleri enjekte ederek RGBL profilinin bu değere nasıl tepki vereceğini test eder." />
                <DockPanel LastChildFill="False" ToolTip.Tip="Simüle edilecek kırmızı kanal değeri (ham sensör sayımı, 0-65535)">
                    <TextBlock DockPanel.Dock="Left" Text="R" />
                    <TextBox
                        MinWidth="60"
                        DockPanel.Dock="Right"
                        Text="{Binding SimulatedR, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                        Theme="{DynamicResource CompactTextBox}" />
                </DockPanel>
                <DockPanel LastChildFill="False" ToolTip.Tip="Simüle edilecek yeşil kanal değeri (ham sensör sayımı, 0-65535)">
                    <TextBlock DockPanel.Dock="Left" Text="G" />
                    <TextBox
                        MinWidth="60"
                        DockPanel.Dock="Right"
                        Text="{Binding SimulatedG, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                        Theme="{DynamicResource CompactTextBox}" />
                </DockPanel>
                <DockPanel LastChildFill="False" ToolTip.Tip="Simüle edilecek mavi kanal değeri (ham sensör sayımı, 0-65535)">
                    <TextBlock DockPanel.Dock="Left" Text="B" />
                    <TextBox
                        MinWidth="60"
                        DockPanel.Dock="Right"
                        Text="{Binding SimulatedB, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                        Theme="{DynamicResource CompactTextBox}" />
                </DockPanel>
                <DockPanel LastChildFill="False" ToolTip.Tip="RGBL eğrisi X-ekseni girişi (0-100). Bu değer R/G/B/L kanallarının hangi noktada değerlendirileceğini belirler.">
                    <TextBlock DockPanel.Dock="Left" Text="Ambient %" />
                    <TextBox
                        MinWidth="60"
                        DockPanel.Dock="Right"
                        Text="{Binding SimulatedAmbientPct, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                        Theme="{DynamicResource CompactTextBox}" />
                </DockPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{Binding ResetInjectionCommand}"
                        Content="Sıfırla"
                        HotKey="Escape"
                        Theme="{DynamicResource MaterialOutlinedButton}"
                        ToolTip.Tip="Giriş alanlarını varsayılana döndürür ve aktif enjeksiyonu iptal eder. Son Okuma ve bağlantı durumunu etkilemez." />
                    <Button
                        Command="{Binding InjectSimulatedReadingCommand}"
                        Content="Inject"
                        Theme="{DynamicResource MaterialOutlinedButton}"
                        ToolTip.Tip="Girilen sahte sensör değerini sisteme enjekte eder; Son Okuma paneli sonucu gösterir." />
                </StackPanel>
            </StackPanel>
        </Border>


    </StackPanel>
</UserControl>
