<UserControl
    x:Class="LightBulb.Views.Dialogs.UsbCalibrationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:LightBulb.Views.Components"
    xmlns:converters="clr-namespace:LightBulb.Converters"
    xmlns:dialogs="clr-namespace:LightBulb.ViewModels.Dialogs"
    Width="560"
    x:DataType="dialogs:UsbCalibrationViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Orientation="Vertical" Spacing="0">

            <!--  Title  -->
            <TextBlock
                Margin="0,0,0,20"
                FontSize="18"
                FontWeight="Light"
                Text="USB Sensör — Kalibrasyon &amp; Ayarlar" />

            <!--  ══════════════════ RGBL BIAS ══════════════════  -->
            <Border
                Margin="0,0,0,20"
                Padding="12"
                Background="{DynamicResource MaterialCardBackgroundBrush}"
                CornerRadius="6">
                <StackPanel Orientation="Vertical" Spacing="0">

                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="SemiBold"
                        Text="RGBL Kanal Ayarları" />
                    <TextBlock
                        Margin="0,0,0,14"
                        FontSize="11"
                        Opacity="0.6"
                        Text="Her kanal için çıkış bias'ı (−1 = bastır, 0 = nötr, +1 = güçlendir). L, son parlaklığı belirler." />

                    <!--  R  -->
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <TextBlock
                            Width="20"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="#EF5350"
                            Text="R" />
                        <TextBox
                            Width="52"
                            DockPanel.Dock="Right"
                            Text="{Binding RBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>
                    <Slider
                        Margin="0,0,0,10"
                        LargeChange="0.2"
                        Maximum="1"
                        Minimum="-1"
                        SmallChange="0.05"
                        Value="{Binding RBias}" />

                    <!--  G  -->
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <TextBlock
                            Width="20"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="#66BB6A"
                            Text="G" />
                        <TextBox
                            Width="52"
                            DockPanel.Dock="Right"
                            Text="{Binding GBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>
                    <Slider
                        Margin="0,0,0,10"
                        LargeChange="0.2"
                        Maximum="1"
                        Minimum="-1"
                        SmallChange="0.05"
                        Value="{Binding GBias}" />

                    <!--  B  -->
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <TextBlock
                            Width="20"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="#42A5F5"
                            Text="B" />
                        <TextBox
                            Width="52"
                            DockPanel.Dock="Right"
                            Text="{Binding BBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>
                    <Slider
                        Margin="0,0,0,10"
                        LargeChange="0.2"
                        Maximum="1"
                        Minimum="-1"
                        SmallChange="0.05"
                        Value="{Binding BBias}" />

                    <!--  L  -->
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <TextBlock
                            Width="20"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Text="L" />
                        <TextBox
                            Width="52"
                            DockPanel.Dock="Right"
                            Text="{Binding LBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                            Theme="{DynamicResource CompactTextBox}" />
                    </DockPanel>
                    <Slider
                        Margin="0,0,0,0"
                        LargeChange="0.2"
                        Maximum="1"
                        Minimum="-1"
                        SmallChange="0.05"
                        Value="{Binding LBias}" />

                </StackPanel>
            </Border>

            <!--  ══════════════════ KALİBRASYON EĞRİSİ ══════════════════  -->
            <Border
                Margin="0,0,0,20"
                Padding="12"
                Background="{DynamicResource MaterialCardBackgroundBrush}"
                CornerRadius="6">
                <StackPanel Orientation="Vertical" Spacing="0">

                    <!--  Header + toggle  -->
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Parlaklık Kalibrasyon Eğrisi" />
                        <ToggleSwitch
                            DockPanel.Dock="Right"
                            IsChecked="{Binding IsCalibrationEnabled}"
                            OffContent="Kapalı"
                            OnContent="Etkin"
                            ToolTip.Tip="Kalibrasyon eğrisini etkinleştirir; devre dışıyken adaptif tepe ölçekleme kullanılır" />
                    </DockPanel>

                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="11"
                        Opacity="0.6"
                        Text="Sensör Y değeri (sol) ile hedef parlaklık %'si (sağ) arasında dönüşüm noktaları tanımlayın.&#10;Noktalar arasında doğrusal interpolasyon uygulanır." />

                    <!--  Toolbar  -->
                    <StackPanel
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{Binding AddPointCommand}"
                            Content="+ Nokta Ekle"
                            Theme="{DynamicResource MaterialOutlinedButton}" />
                        <Button
                            Command="{Binding ResetToDefaultCommand}"
                            Content="Varsayılana Sıfırla"
                            Theme="{DynamicResource MaterialOutlinedButton}" />
                    </StackPanel>

                    <!--  Points table header  -->
                    <Grid Margin="0,0,0,4" ColumnDefinitions="*,*,Auto,Auto">
                        <TextBlock
                            Grid.Column="0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="Sensör Y Değeri" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="Parlaklık (%)" />
                    </Grid>

                    <!--  Points rows  -->
                    <ItemsControl ItemsSource="{Binding CalibrationPoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="dialogs:CalibrationPointViewModel">
                                <Grid
                                    Margin="0,2,0,2"
                                    ColumnDefinitions="*,*,Auto,Auto"
                                    VerticalAlignment="Center">
                                    <TextBox
                                        Grid.Column="0"
                                        Margin="0,0,4,0"
                                        Text="{Binding RawY, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                        Theme="{DynamicResource CompactTextBox}"
                                        ToolTip.Tip="Sensörden gelen ham CIE-Y değeri" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,4,0"
                                        Text="{Binding BrightnessPercent, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                        Theme="{DynamicResource CompactTextBox}"
                                        ToolTip.Tip="Bu Y değerinde uygulanacak ekran parlaklığı (0–100)" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="0,0,4,0"
                                        Padding="6,2"
                                        Command="{Binding $parent[UserControl].((dialogs:UsbCalibrationViewModel)DataContext).CaptureCurrentCommand}"
                                        CommandParameter="{Binding}"
                                        Content="Şimdi Al"
                                        FontSize="11"
                                        Theme="{DynamicResource MaterialOutlinedButton}"
                                        ToolTip.Tip="Şu anki sensör Y değerini bu satıra yazar" />
                                    <Button
                                        Grid.Column="3"
                                        Padding="6,2"
                                        Command="{Binding $parent[UserControl].((dialogs:UsbCalibrationViewModel)DataContext).RemovePointCommand}"
                                        CommandParameter="{Binding}"
                                        Content="✕"
                                        FontSize="11"
                                        Theme="{DynamicResource MaterialOutlinedButton}"
                                        ToolTip.Tip="Bu noktayı sil" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Calibration curve  -->
                    <Border
                        Margin="0,14,0,6"
                        BorderBrush="{DynamicResource MaterialDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <components:CalibrationCurveControl
                            Height="200"
                            LiveRawY="{Binding LatestRawY}"
                            Points="{Binding CalibrationCurvePoints}" />
                    </Border>

                    <!--  Live reading strip  -->
                    <Border
                        Margin="0,6,0,0"
                        Padding="8,6"
                        Background="{DynamicResource MaterialCardBackgroundBrush}"
                        CornerRadius="4">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Opacity="0.6" Text="Ham: " />
                            <TextBlock
                                Margin="0,0,16,0"
                                FontFamily="Monospace"
                                Text="{Binding LastRawReading}" />
                            <TextBlock Opacity="0.6" Text="Y = " />
                            <TextBlock
                                Margin="0,0,16,0"
                                FontFamily="Monospace"
                                Text="{Binding LatestRawY, StringFormat=\{0:F2\}}" />
                            <TextBlock Opacity="0.6" Text="CCT: " />
                            <TextBlock
                                Margin="0,0,16,0"
                                FontFamily="Monospace"
                                Text="{Binding LatestCctText}" />
                            <TextBlock Opacity="0.6" Text="Parlaklık: " />
                            <TextBlock
                                FontFamily="Monospace"
                                Text="{Binding LatestLuminance, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}}" />
                        </WrapPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!--  Close button  -->
            <Button
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Content="Kapat"
                Theme="{DynamicResource MaterialOutlinedButton}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
