<UserControl
    x:Class="LightBulb.Views.Dialogs.UsbCalibrationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:LightBulb.Views.Components"
    xmlns:converters="clr-namespace:LightBulb.Converters"
    xmlns:dialogs="clr-namespace:LightBulb.ViewModels.Dialogs"
    Width="560"
    x:DataType="dialogs:UsbCalibrationViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Orientation="Vertical" Spacing="0">

            <!--  Title  -->
            <TextBlock
                Margin="0,0,0,20"
                FontSize="18"
                FontWeight="Light"
                Text="USB Sensör — Kalibrasyon &amp; Ayarlar" />

            <!--  ══════════════════ KALİBRASYON EĞRİSİ ══════════════════  -->
            <Border
                Margin="0,0,0,20"
                Padding="12"
                Background="{DynamicResource MaterialCardBackgroundBrush}"
                CornerRadius="6">
                <StackPanel Orientation="Vertical" Spacing="0">

                    <!--  Header + toggle  -->
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Parlaklık &amp; Renk Kalibrasyon Eğrileri" />
                        <ToggleSwitch
                            DockPanel.Dock="Right"
                            IsChecked="{Binding IsCalibrationEnabled}"
                            OffContent="Kapalı"
                            OnContent="Etkin"
                            ToolTip.Tip="Kalibrasyon eğrilerini etkinleştirir" />
                    </DockPanel>

                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="11"
                        Opacity="0.6"
                        Text="Her nokta için sensör Y değeri ve her kanal (Parlaklık, R, G, B, L) değerlerini tanımlayın.&#10;Noktalar arasında lineer interpolasyon uygulanır. Sol tık = nokta ekle/sürükle, Sağ tık = sil." />

                    <!--  Toolbar  -->
                    <StackPanel
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{Binding AddPointCommand}"
                            Content="+ Nokta Ekle"
                            Theme="{DynamicResource MaterialOutlinedButton}" />
                        <Button
                            Command="{Binding ResetToDefaultCommand}"
                            Content="Varsayılana Sıfırla"
                            Theme="{DynamicResource MaterialOutlinedButton}" />
                    </StackPanel>

                    <!--  Points table header  -->
                    <Grid Margin="0,0,0,4" ColumnDefinitions="*,*,Auto,Auto">
                        <TextBlock
                            Grid.Column="0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="Sensör Y Değeri" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="Parlaklık (%)" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="4,0,42,0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="R / G / B / L" />
                    </Grid>

                    <!--  Points rows  -->
                    <ItemsControl ItemsSource="{Binding CalibrationPoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="dialogs:CalibrationPointViewModel">
                                <Border
                                    Margin="0,1,0,1"
                                    Padding="0,4"
                                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                                    BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Vertical" Spacing="3">

                                        <!--  Row 1: Y, Brightness, buttons  -->
                                        <Grid ColumnDefinitions="*,*,Auto,Auto" VerticalAlignment="Center">
                                            <TextBox
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                Text="{Binding RawY, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                                Theme="{DynamicResource CompactTextBox}"
                                                ToolTip.Tip="Sensörden gelen ham CIE-Y değeri" />
                                            <TextBox
                                                Grid.Column="1"
                                                Margin="0,0,4,0"
                                                Text="{Binding BrightnessPercent, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                                Theme="{DynamicResource CompactTextBox}"
                                                ToolTip.Tip="Bu Y değerinde uygulanacak ekran parlaklığı (0–100)" />
                                            <Button
                                                Grid.Column="2"
                                                Margin="0,0,4,0"
                                                Padding="6,2"
                                                Command="{Binding $parent[UserControl].((dialogs:UsbCalibrationViewModel)DataContext).CaptureCurrentCommand}"
                                                CommandParameter="{Binding}"
                                                Content="Şimdi Al"
                                                FontSize="11"
                                                Theme="{DynamicResource MaterialOutlinedButton}"
                                                ToolTip.Tip="Şu anki sensör Y değerini bu satıra yazar" />
                                            <Button
                                                Grid.Column="3"
                                                Padding="6,2"
                                                Command="{Binding $parent[UserControl].((dialogs:UsbCalibrationViewModel)DataContext).RemovePointCommand}"
                                                CommandParameter="{Binding}"
                                                Content="✕"
                                                FontSize="11"
                                                Theme="{DynamicResource MaterialOutlinedButton}"
                                                ToolTip.Tip="Bu noktayı sil" />
                                        </Grid>

                                        <!--  Row 2: compact R/G/B/L numeric inputs (Option B fallback)  -->
                                        <Grid
                                            Margin="0,0,36,0"
                                            ColumnDefinitions="Auto,64,Auto,64,Auto,64,Auto,64">
                                            <TextBlock
                                                Grid.Column="0"
                                                Width="18"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="#EF5350"
                                                Text="R" />
                                            <TextBox
                                                Grid.Column="1"
                                                Margin="0,0,6,0"
                                                Text="{Binding RBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                                Theme="{DynamicResource CompactTextBox}"
                                                ToolTip.Tip="R kanalı bias (−1 … +1)" />

                                            <TextBlock
                                                Grid.Column="2"
                                                Width="18"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="#66BB6A"
                                                Text="G" />
                                            <TextBox
                                                Grid.Column="3"
                                                Margin="0,0,6,0"
                                                Text="{Binding GBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                                Theme="{DynamicResource CompactTextBox}"
                                                ToolTip.Tip="G kanalı bias (−1 … +1)" />

                                            <TextBlock
                                                Grid.Column="4"
                                                Width="18"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="#42A5F5"
                                                Text="B" />
                                            <TextBox
                                                Grid.Column="5"
                                                Margin="0,0,6,0"
                                                Text="{Binding BBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                                Theme="{DynamicResource CompactTextBox}"
                                                ToolTip.Tip="B kanalı bias (−1 … +1)" />

                                            <TextBlock
                                                Grid.Column="6"
                                                Width="18"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Opacity="0.8"
                                                Text="L" />
                                            <TextBox
                                                Grid.Column="7"
                                                Text="{Binding LBias, Converter={x:Static converters:DoubleToStringConverter.Instance}, UpdateSourceTrigger=LostFocus}"
                                                Theme="{DynamicResource CompactTextBox}"
                                                ToolTip.Tip="L (parlaklık) bias (−1 … +1)" />
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Channel selector + graph  -->
                    <StackPanel Margin="0,12,0,0" Orientation="Vertical" Spacing="6">

                        <!--  Channel toggle row  -->
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.6"
                                Text="Kanal:" />
                            <ToggleButton
                                IsChecked="{Binding IsChannelBrightness}"
                                FontSize="11"
                                Padding="8,3"
                                Content="Parlaklık"
                                ToolTip.Tip="Parlaklık eğrisini düzenle (0–100 %)" />
                            <ToggleButton
                                IsChecked="{Binding IsChannelR}"
                                FontSize="11"
                                Padding="8,3"
                                Foreground="#EF5350"
                                Content="R"
                                ToolTip.Tip="Kırmızı kanal bias eğrisini düzenle (−1 … +1)" />
                            <ToggleButton
                                IsChecked="{Binding IsChannelG}"
                                FontSize="11"
                                Padding="8,3"
                                Foreground="#66BB6A"
                                Content="G"
                                ToolTip.Tip="Yeşil kanal bias eğrisini düzenle (−1 … +1)" />
                            <ToggleButton
                                IsChecked="{Binding IsChannelB}"
                                FontSize="11"
                                Padding="8,3"
                                Foreground="#42A5F5"
                                Content="B"
                                ToolTip.Tip="Mavi kanal bias eğrisini düzenle (−1 … +1)" />
                            <ToggleButton
                                IsChecked="{Binding IsChannelL}"
                                FontSize="11"
                                Padding="8,3"
                                Content="L"
                                ToolTip.Tip="Parlaklık (L) bias eğrisini düzenle (−1 … +1)" />
                        </StackPanel>

                        <!--  Interactive calibration curve  -->
                        <Border
                            BorderBrush="{DynamicResource MaterialDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <components:CalibrationCurveControl
                                x:Name="CurveControl"
                                Height="220"
                                LiveRawY="{Binding LatestRawY}"
                                Points="{Binding CalibrationCurvePoints}"
                                SelectedChannel="{Binding SelectedChannel}" />
                        </Border>
                    </StackPanel>

                    <!--  Live reading strip  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="8,6"
                        Background="{DynamicResource MaterialCardBackgroundBrush}"
                        CornerRadius="4">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Opacity="0.6" Text="Ham: " />
                            <TextBlock
                                Margin="0,0,16,0"
                                FontFamily="Monospace"
                                Text="{Binding LastRawReading}" />
                            <TextBlock Opacity="0.6" Text="Y = " />
                            <TextBlock
                                Margin="0,0,16,0"
                                FontFamily="Monospace"
                                Text="{Binding LatestRawY, StringFormat=\{0:F2\}}" />
                            <TextBlock Opacity="0.6" Text="CCT: " />
                            <TextBlock
                                Margin="0,0,16,0"
                                FontFamily="Monospace"
                                Text="{Binding LatestCctText}" />
                            <TextBlock Opacity="0.6" Text="Parlaklık: " />
                            <TextBlock
                                FontFamily="Monospace"
                                Text="{Binding LatestLuminance, Converter={x:Static converters:FractionToPercentageStringConverter.Instance}}" />
                        </WrapPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!--  Bottom action row  -->
            <DockPanel LastChildFill="False">
                <Button
                    DockPanel.Dock="Left"
                    Command="{Binding OpenSimulationCommand}"
                    Content="🎛️ RGBL Simülasyon Aracını Aç"
                    Theme="{DynamicResource MaterialOutlinedButton}"
                    ToolTip.Tip="RGBL Eğri Editörü + Simülasyon Odasını tarayıcıda açar" />
                <Button
                    DockPanel.Dock="Right"
                    Command="{Binding CloseCommand}"
                    Content="Kapat"
                    Theme="{DynamicResource MaterialOutlinedButton}">
                    <Button.CommandParameter>
                        <x:Boolean>True</x:Boolean>
                    </Button.CommandParameter>
                </Button>
            </DockPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
